<file path="src/components/TechnicalSupportBounder/Form.tsx">
import { ELoaiPhanHoi } from '@/services/TienIch/PhanHoi/constant';
import { buildUpLoadFile } from '@/services/uploadFile';
import rules from '@/utils/rules';
import { Button, Card, Form, Input } from 'antd';
import { useModel } from 'umi';
import FormItemUrlOrUpload from '../Upload/FormItemUrlOrUpload';
import { useEffect } from 'react';
import { resetFieldsForm } from '@/utils/utils';

const FormPostIssue = (props: { visible: boolean; setVisible: (val: boolean) => void }) => {
	const { formSubmiting, postModel, setFormSubmiting } = useModel('tienich.phanhoi');
	const [form] = Form.useForm();
	const { visible, setVisible } = props;

	useEffect(() => {
		if (!visible) resetFieldsForm(form);
	}, [visible]);

	const onFinish = async (values: any) => {
		if (!!values.urlPhanAnh && typeof values.urlPhanAnh !== 'string') {
			setFormSubmiting(true);
			await buildUpLoadFile(values, 'urlPhanAnh')
				.then((urlPhanAnh) => (values.urlPhanAnh = urlPhanAnh))
				.catch(() => (values.urlPhanAnh = null))
				.finally(() => setFormSubmiting(false));
		}

		postModel({
			...values,
			loaiPhanHoi: ELoaiPhanHoi.KY_THUAT,
		})
			.then(() => {
				setVisible(false);
			})
			.catch((er) => console.log(er));
	};

	return (
		<Card title='Phản hồi kĩ thuật'>
			<Form layout='vertical' onFinish={onFinish} form={form}>
				<Form.Item
					rules={[...rules.required, ...rules.length(5000), ...rules.text]}
					name='noiDungPhanHoi'
					label='Mô tả chi tiết'
				>
					<Input.TextArea rows={3} placeholder='Mô tả chi tiết' />
				</Form.Item>

				<FormItemUrlOrUpload form={form} field='urlPhanAnh' />

				<div className='form-footer'>
					<Button loading={formSubmiting} htmlType='submit' type='primary'>
						Gửi phản hồi
					</Button>
					<Button onClick={() => setVisible(false)}>Hủy</Button>
				</div>
			</Form>
		</Card>
	);
};

export default FormPostIssue;
</file>

<file path="src/components/TinyEditor/style.less">
@import '~antd/es/style/themes/default.less';
@import '../../styles/_variable.less';

@border-color: #D9D9D9;

.tox-statusbar__branding {
	display: none !important;
}

.tox .tox-mbtn:hover,
.tox .tox-tbtn:hover,
.tox .tox-tbtn--enabled,
.tox .tox-tbtn--enabled:hover,
.tox .tox-split-button:focus {
	background: var(--primary-1) !important;
}

.tox-tinymce {
	border: 1px solid @border-color !important;
	border-radius: @border-radius !important;
	transition: 0.3s;

	&:hover,
	&.tox-edit-focus {
		border-color: var(--primary-color) !important;
		transition: 0.3s;
	}

	&.tox-edit-focus {
		box-shadow: 0 0 0 2px var(--ant-primary-color-outline);
	}

	.tox-editor-header {
		padding: 0 !important;

		.tox-menubar {
			border-bottom: 1px solid @border-color !important;
		}

		.tox-toolbar-overlord {
			border: none !important;
			margin: 0 !important;
			padding: 0 !important;
		}

		.tox-toolbar__group:not(:last-of-type) {
			border-right: 1px solid @border-color !important;
		}
	}

	.tox-edit-area::before {
		border: none !important;
	}

	.tox-promotion {
		display: none;
	}
}

.tox-menu {
	padding: 0 !important;
	border-radius: @border-radius !important;

	.tox-collection__item {
		border-radius: @border-radius !important;

		&.tox-collection__item--active {
			background-color: var(--primary-1) !important;
			color: #222f3e !important;
		}
	}
}

.tox-pop__dialog {
	border-radius: @border-radius !important;
}

.tox-dialog-wrap {
	.tox-dialog-wrap__backdrop {
		background-color: rgba(0, 0, 0, .45);
	}

	.tox-dialog {
		border-radius: @border-radius;
	}
}

.tox-button {
	border-radius: @border-radius !important;
}

.tox-mbtn:focus:not(:disabled)::after,
.tox-tbtn:focus::after,
.tox-split-button:focus::after {
	border-radius: @border-radius !important;
	border: 1px solid var(--primary-color);
	box-shadow: 0 0 0 2px var(--ant-primary-color-outline) !important;
}
