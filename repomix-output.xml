import React, { useMemo, useEffect, useState } from 'react';
import { useParams, history } from 'umi';
import { Card, Tag, Avatar, Button, Space, Divider, Typography, Row, Col } from 'antd';
import { ArrowLeftOutlined, EyeOutlined } from '@ant-design/icons';
import ReactMarkdown from 'react-markdown';
import { mockPosts } from '../../../mock/blog';
import type { BlogPost } from '../../models/blog';

const { Title, Paragraph } = Typography;

const BlogDetail: React.FC = () => {
  const { slug } = useParams<{ slug: string }>();
  const [views, setViews] = useState(0);
  const post = useMemo(() => mockPosts.find((p: BlogPost) => p.slug === slug), [slug]);

  useEffect(() => {
    if (post) setViews(post.views + 1);
  }, [post]);

  const related = useMemo(() => {
    if (!post) return [];
    return mockPosts
      .filter((p) => p.id !== post.id && p.status === 'published' && p.tags.some(t => post.tags.includes(t)))
      .slice(0, 3);
  }, [post]);

  if (!post) return <div>Không tìm thấy bài viết.</div>;

  return (
    <div style={{ maxWidth: 900, margin: '0 auto', padding: 24 }}>
      <Button icon={<ArrowLeftOutlined />} onClick={() => history.goBack()} style={{ marginBottom: 24 }}>
        Quay lại
      </Button>
      <Card
        cover={<img alt={post.title} src={post.coverUrl} style={{ height: 260, objectFit: 'cover' }} />}
