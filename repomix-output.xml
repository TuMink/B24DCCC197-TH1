<file path="src/pages/Admin/Posts.tsx">
import React, { useState } from 'react';
import { Table, Tag, Space, Button, Popconfirm, Input, Modal, Form, Select, Radio, message } from 'antd';
import { EditOutlined, DeleteOutlined, PlusOutlined } from '@ant-design/icons';
import * as blogService from '../../services/blog';
import type { BlogPost } from '../../models/blog';

const statusColors = { published: 'green', draft: 'orange' };

const PostForm: React.FC<{
  visible: boolean;
  onOk: (values: Partial<BlogPost>) => void;
  onCancel: () => void;
  initialValues?: Partial<BlogPost>;
}> = ({ visible, onOk, onCancel, initialValues }) => {
  const [form] = Form.useForm();
  const [availableTags, setAvailableTags] = useState<{ label: string; value: string }[]>([]);

  React.useEffect(() => { 
    // Lấy danh sách thẻ từ API để đồng bộ làm gợi ý chọn Thẻ
    blogService.getTags().then(tags => {
      setAvailableTags(tags.map(t => ({ label: t.name, value: t.name })));
    });

    if (visible) {
      form.resetFields();
      form.setFieldsValue(initialValues || { status: 'published' }); 
    } 
  }, [visible, initialValues, form]);

  // Hàm tự động tạo slug từ tiêu đề bài viết thông qua sự thay đổi của Form
  const handleValuesChange = (changedValues: any) => {
    if (changedValues.title && !initialValues?.id) {
      // Chỉ tự động tạo slug khi thêm mới
      const generatedSlug = changedValues.title
        .toLowerCase()
        .normalize('NFD') // Loại bỏ dấu tiếng việt
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9\s-]/g, '') // Chỉ giữ lại chữ, số và khoảng trắng
        .replace(/\s+/g, '-') // Đổi khoảng trắng thành gạch ngang
        .replace(/-+/g, '-');
      form.setFieldsValue({ slug: generatedSlug });
    }
  };

  return (
    <Modal 
      open={visible} 
      visible={visible} // Hỗ trợ tương thích Ant Design v4
      destroyOnClose
      title={initialValues?.id ? 'Sửa bài viết' : 'Thêm bài viết'} 
      onOk={() => form.submit()} 
      onCancel={onCancel} 
      okText="Lưu" 
      cancelText="Hủy"
    >
      <Form form={form} layout="vertical" onFinish={onOk} onValuesChange={handleValuesChange}>
        <Form.Item name="title" label="Tiêu đề" rules={[{ required: true, message: 'Vui lòng nhập tiêu đề' }]}><Input placeholder="Nhập tiêu đề bài viết" /></Form.Item>
        <Form.Item name="slug" label="Đường dẫn (Slug)" rules={[{ required: true, message: 'Vui lòng nhập đường dẫn' }]}><Input placeholder="nhap-tieu-de-bai-viet" /></Form.Item>
        <Form.Item name="content" label="Nội dung" rules={[{ required: true, message: 'Vui lòng nhập nội dung bài viết' }]}><Input.TextArea rows={4} placeholder="Nội dung bài viết (hỗ trợ Markdown)..." /></Form.Item>
        <Form.Item name="coverUrl" label="Ảnh bìa (URL)"><Input placeholder="https://..." /></Form.Item>
        <Form.Item name="tags" label="Thẻ (Tags)"><Select mode="tags" placeholder="Chọn hoặc nhập thêm thẻ" options={availableTags} /></Form.Item>
        <Form.Item name="status" label="Trạng thái"><Radio.Group options={[{label:'Đã xuất bản',value:'published'},{label:'Bản nháp',value:'draft'}]} /></Form.Item>
      </Form>
    </Modal>
  );
};

const AdminPosts: React.FC = () => {
  const [data, setData] = useState<BlogPost[]>([]);
  const [search, setSearch] = useState('');
  const [status, setStatus] = useState<string | undefined>();
  const [tag, setTag] = useState<string | undefined>();
  const [editing, setEditing] = useState<BlogPost | undefined>();
  const [formVisible, setFormVisible] = useState(false);
  const [availableTags, setAvailableTags] = useState<{ label: string; value: string }[]>([]);

  React.useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    const posts = await blogService.getPosts();
    setData(posts);
    const tags = await blogService.getTags();
    setAvailableTags(tags.map(t => ({ label: t.name, value: t.name })));
  };

  const filtered = data.filter(post =>
    (!search || post.title?.toLowerCase().includes(search.toLowerCase())) &&
    (!status || post.status === status) &&
    (!tag || post.tags?.includes(tag))
  );

  const handleAddOrEdit = async (values: Partial<BlogPost>) => {
    if (editing) {
      await blogService.updatePost(editing.id, values);
      message.success('Cập nhật bài viết thành công!');
    } else {
      await blogService.addPost(values);
      message.success('Thêm bài viết thành công!');
    }
    await fetchData();
    setFormVisible(false);
  };

  const handleDelete = async (id: string) => {
    await blogService.deletePost(id);
    message.success('Xóa bài viết thành công!');
    await fetchData();
  };

  const columns = [
    { title: 'Tiêu đề', dataIndex: 'title', key: 'title' },
    { title: 'Trạng thái', dataIndex: 'status', key: 'status', render: (v: string) => <Tag color={statusColors[v as keyof typeof statusColors]}>{v === 'published' ? 'Đã xuất bản' : 'Bản nháp'}</Tag> },
    { title: 'Thẻ', dataIndex: 'tags', key: 'tags', render: (tags: string[]) => tags?.map(t => <Tag key={t}>{t}</Tag>) },
    { title: 'Lượt xem', dataIndex: 'views', key: 'views' },
    { title: 'Ngày tạo', dataIndex: 'createdAt', key: 'createdAt' },
    {
      title: 'Hành động', key: 'actions', render: (_: any, record: BlogPost) => (
        <Space>
          <Button icon={<EditOutlined />} size="small" onClick={() => { setEditing(record); setFormVisible(true); }} />
          <Popconfirm title="Bạn có chắc chắn muốn xóa bài viết này?" onConfirm={() => handleDelete(record.id)} okText="Có" cancelText="Không">
            <Button icon={<DeleteOutlined />} size="small" danger />
          </Popconfirm>
        </Space>
      )
    }
  ];

  return (
    <div style={{ padding: 24 }}>
      <Space style={{ marginBottom: 16, flexWrap: 'wrap' }}>
        <Input.Search placeholder="Tìm kiếm tiêu đề" allowClear onChange={e => setSearch(e.target.value)} style={{ width: 200 }} />
        <Select placeholder="Trạng thái" allowClear style={{ width: 150 }} onChange={setStatus} options={[{label:'Đã xuất bản',value:'published'},{label:'Bản nháp',value:'draft'}]} />
        <Select placeholder="Lọc theo thẻ" allowClear style={{ width: 150 }} onChange={setTag} options={availableTags} />
        <Button icon={<PlusOutlined />} type="primary" onClick={() => { setEditing(undefined); setFormVisible(true); }}>Thêm bài viết</Button>
      </Space>
      <Table rowKey="id" columns={columns} dataSource={filtered} pagination={{ pageSize: 10 }} />
      <PostForm
        visible={formVisible}
        onOk={handleAddOrEdit}
        onCancel={() => setFormVisible(false)}
        initialValues={editing}
      />
    </div>
  );
};

export default AdminPosts;
</file>

