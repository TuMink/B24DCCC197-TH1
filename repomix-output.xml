        {
            path: '/blog/:slug',
            component: '@/pages/Blog/Detail',
            hideInMenu: true,
        },
        {
            path: '/about',
            name: 'About',
            icon: 'UserOutlined',
            component: '@/pages/About',
        },
        {
            path: '/admin/posts',
            name: 'Quản lý Bài viết',
            icon: 'FileTextOutlined',
            component: '@/pages/Admin/Posts',
