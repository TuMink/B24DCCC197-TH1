import { BlogPost, Tag } from '../models/blog';
import { mockPosts, mockTags } from '../../mock/blog';

const getStoredPosts = (): BlogPost[] => {
  const stored = localStorage.getItem('blog_posts');
  if (stored) return JSON.parse(stored);
  localStorage.setItem('blog_posts', JSON.stringify(mockPosts));
  return [...mockPosts];
};

const getStoredTags = (): Tag[] => {
  const stored = localStorage.getItem('blog_tags');
  if (stored) return JSON.parse(stored);
  localStorage.setItem('blog_tags', JSON.stringify(mockTags));
  return [...mockTags];
};

export async function getPosts() {
  return getStoredPosts();
}

export async function addPost(post: Partial<BlogPost>) {
  const posts = getStoredPosts();
  const newPost: BlogPost = {
    ...post,
    id: Date.now().toString(),
    views: 0,
    createdAt: new Date().toISOString().slice(0, 10),
    author: { name: 'Admin', avatar: '' },
    status: post.status || 'draft',
  } as BlogPost;
  const newPosts = [newPost, ...posts];
  localStorage.setItem('blog_posts', JSON.stringify(newPosts));
  return newPost;
}

export async function updatePost(id: string, post: Partial<BlogPost>) {
  let posts = getStoredPosts();
  posts = posts.map(p => p.id === id ? { ...p, ...post } as BlogPost : p);
  localStorage.setItem('blog_posts', JSON.stringify(posts));
  return posts.find(p => p.id === id);
}

export async function deletePost(id: string) {
  let posts = getStoredPosts();
  posts = posts.filter(p => p.id !== id);
  localStorage.setItem('blog_posts', JSON.stringify(posts));
  return true;
}

export async function getTags() {
  const tags = getStoredTags();
  const posts = getStoredPosts();

  // Tự động đếm số lượng bài viết thực tế cho từng thẻ để đồng bộ
  return tags.map(tag => ({
    ...tag,
    postCount: posts.filter(post => post.tags?.includes(tag.name)).length
  }));
}

export async function addTag(tag: Partial<Tag>) {
  const tags = getStoredTags();
  const newTag: Tag = { ...tag, postCount: 0 } as Tag;
  const newTags = [newTag, ...tags];
  localStorage.setItem('blog_tags', JSON.stringify(newTags));
  return newTag;
}

export async function updateTag(name: string, tag: Partial<Tag>) {
  let tags = getStoredTags();
  tags = tags.map(t => t.name === name ? { ...t, ...tag } as Tag : t);
  localStorage.setItem('blog_tags', JSON.stringify(tags));
  return tags.find(t => t.name === name);
}

export async function deleteTag(name: string) {
  let tags = getStoredTags();
  tags = tags.filter(t => t.name !== name);
  localStorage.setItem('blog_tags', JSON.stringify(tags));
  return true;
}
